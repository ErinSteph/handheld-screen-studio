{
  "name": "handheld-screen-studio",
  "displayName": "Handheld Screen Studio",
  "description": "Visual handheld layouts, C/C++ drawing previews and readable C source export.",
  "version": "0.7.0",
  "publisher": "ErinSteph",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./extension.cjs",
  "activationEvents": [
    "onCommand:handheldScreens.open",
    "onCommand:handheldScreens.newProject",
    "workspaceContains:.handheld-project.json"
  ],
  "contributes": {
    "commands": [
      {
        "command": "handheldScreens.open",
        "title": "Handheld Screen Studio: Open Editor"
      },
      {
        "command": "handheldScreens.newProject",
        "title": "Handheld Screen Studio: New Project"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "handheldScreens.open",
          "when": "resourceFilename == presentation.h || resourceFilename =~ /\\.tm-screen\\.json$/",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "test": "node --test test/*.test.cjs",
    "check": "node --check extension.cjs && node --check source.cjs && node --check layout.cjs && node --check media/studio.js && node --check detection.cjs && node --check export.cjs && node --check adapters.cjs && node --check images.cjs && node --check project.cjs && node --check raster.cjs && node --check dual.cjs && node --check media/dual-view.js",
    "package": "vsce package",
    "publish:marketplace": "vsce publish --oidc"
  },
  "license": "MIT",
  "author": {
    "name": "Erin Steph"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ErinSteph/handheld-screen-studio.git"
  },
  "homepage": "https://github.com/ErinSteph/handheld-screen-studio#readme",
  "bugs": {
    "url": "https://github.com/ErinSteph/handheld-screen-studio/issues"
  },
  "keywords": [
    "gameboy",
    "gba",
    "nds",
    "3ds",
    "layout",
    "wysiwyg"
  ],
  "preview": true,
  "devDependencies": {
    "@vscode/vsce": "4.1.1"
  },
  "icon": "media/icon.png",
  "dependencies": {
    "pngjs": "7.0.0"
  }
}
